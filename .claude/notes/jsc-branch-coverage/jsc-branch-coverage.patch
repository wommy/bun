+#pragma once
+
+#include <cstdint>
+
+namespace JSC {
+
+// Why control reaches the top of a basic block recorded by the control flow profiler.
+//
+// The profiler opens a basic block after *every* construct that ends a flow of control, not just
+// at the arms of a conditional: the statement slot after `return`, `throw`, `break` and `continue`
+// gets one, and so does the join point after an `if`, a loop or a `switch`. Those blocks are not
+// decisions - the ones after a terminator are not even reachable - so a consumer that treats every
+// basic block as a branch (an lcov BRDA writer, say) reports branches that no test can ever cover.
+//
+// Branch marks the blocks that exist *because a condition selected this path*: the arms of
+// if/else and of ?:, the body of a loop, a switch case clause, a catch handler, and the
+// right-hand side of &&, || and ??. Continuation marks everything else.
+//
+// This is a property of the individual emission site, not of the AST node: a single node emits
+// both kinds. ConditionalNode, for instance, opens two Branch blocks (its two arms) and one
+// Continuation block (the join after the whole expression).
+enum class BasicBlockKind : uint8_t {
+    Continuation,
+    Branch,
+};
+
+} // namespace JSC
